########################################################
# Azure OpenAI API 配置
########################################################

# Azure OpenAI API 密钥（必需）
AZURE_OPENAI_API_KEY=your-azure-api-key-here

# Azure OpenAI 部署名称（生成模型）
AZURE_DEPLOYMENT_NAME_CHAT=gpt-4-mini

# Azure OpenAI 部署名称（嵌入模型）
AZURE_DEPLOYMENT_NAME_EMBED=text-embedding-3-small

# Azure OpenAI 基础 URL（endpoint）
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI API 版本（建议使用最新版本）
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# API 超时时间（秒，默认：180 = 3分钟）
AZURE_API_TIMEOUT=180

########################################################
# 向量数据库配置
########################################################

# ChromaDB 数据库路径（可选，默认：./vector_db）
CHROMA_DB_PATH=./vector_db

########################################################
# 注意事项
########################################################

# 1. 获取 Azure OpenAI 信息：
#    - API 密钥：从 Azure Portal 复制
#    - 部署名称：在 Azure OpenAI Studio 中查看
#    - 基础 URL：格式为 https://<resource-name>.openai.azure.com/
# 2. 嵌入向量维度：text-embedding-3-small 默认为 1536 维