########################################################
# 千问AI平台（Qwen AI Platform）API 配置
########################################################

# 平台 API 密钥（必填，以 sk-ws- 开头）
# 获取地址：https://platform.qianwenai.com/home/api-keys
ALIYUN_MODEL_API_KEY=your-api-key-here

# API 端点（可选，使用默认值即可）
# 注意：接口域名是 maas.qianwenaiapi.com，与官网 www.qianwenai.com 不同
ALIYUN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# 对话生成模型（可选，默认：qwen3.7-plus）
# 可选值：qwen3.7-plus（均衡，推荐）、qwen3.8-flash（更快更便宜）、qwen3.8-max（最强，最贵）
# 模型列表：https://www.qianwenai.com/models
ALIYUN_CHAT_MODEL=qwen3.7-plus

# 文本嵌入模型（可选，默认：text-embedding-v4）
# 继续使用 text-embedding-v4 可直接复用已有向量库；换成 qwen3.7-text-embedding 需重新导入文档
ALIYUN_EMBED_MODEL=text-embedding-v4

# 嵌入向量维度（可选，默认 1024）
ALIYUN_EMBED_DIM=1024

# API 超时时间（秒，默认：180 = 3分钟）
ALIYUN_API_TIMEOUT=180

########################################################
# 向量数据库配置
########################################################

# ChromaDB 数据库路径（可选，默认：./vector_db）
CHROMA_DB_PATH=./vector_db

########################################################
# 注意事项
########################################################

# 1. 获取 API 密钥：
#    - 访问 https://platform.qianwenai.com/home/api-keys
#    - 创建或查看您的 API Key（sk-ws- 开头）
# 2. 模型选择建议：
#    - qwen3.7-plus：能力与成本均衡，1M 上下文（推荐）
#    - qwen3.8-flash：接近旗舰水平，价格更低，适合高并发
#    - qwen3.8-max：最强推理与编程能力，价格最高
# 3. 嵌入向量维度：text-embedding-v4 支持 64~2048 维（默认 1024）